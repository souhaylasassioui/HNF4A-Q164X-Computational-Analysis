integrator  = md
nsteps      = 1000000
dt          = 0.001

nstxout-compressed = 5000
nstenergy   = 5000
nstlog      = 5000

continuation = yes
constraint_algorithm = lincs
constraints = h-bonds

cutoff-scheme = Verlet
nstlist     = 20
rlist       = 1.0
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0

tcoupl      = V-rescale
tc-grps     = Protein Water_and_ions
tau_t       = 0.5 0.5
ref_t       = 300 300

pcoupl      = C-rescale
pcoupltype  = isotropic
tau_p       = 5.0
ref_p       = 1.0
compressibility = 4.5e-5

pbc         = xyz
DispCorr    = EnerPres
gen_vel     = no
